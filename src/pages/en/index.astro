---
import Layout from '../../layouts/Layout.astro';
import FeedItemCard from '../../components/molecules/FeedItemCard.astro';
import LaunchHeatmap from '../../components/molecules/LaunchHeatmap.astro';
import { siteConfig } from '../../config/site';
import { getAllItems, getCounts, getGeneratedAt, sourceLabels, categoryLabel } from '../../lib/data';
import { useTranslations, getDateLocale, type Locale } from '../../i18n/messages';
import {
  Zap, TrendingUp, Sparkles, Code, Bot, BookOpen, Briefcase,
  Microscope, Palette, GraduationCap, Wrench, ShieldCheck, Megaphone, Layers,
} from '@lucide/astro';

const CategoryIcon: Record<string, any> = {
  'claude': Sparkles, 'coding': Code, 'agents': Bot,
  'beginners': BookOpen, 'business': Briefcase, 'research': Microscope,
  'creative': Palette, 'fundamentals': GraduationCap,
  'tool-insights': Wrench, 'official': ShieldCheck, 'branding': Megaphone,
};

const CATEGORY_ORDER = [
  'claude', 'coding', 'agents', 'tool-insights', 'fundamentals',
  'research', 'business', 'creative', 'beginners', 'branding', 'official',
];

const locale = (Astro.currentLocale ?? 'nl') as Locale;
const t = useTranslations(locale);

const items = getAllItems();
const counts = getCounts();
const generatedAt = getGeneratedAt();

const updated = new Date(generatedAt).toLocaleDateString(getDateLocale(locale), {
  day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit',
});

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: t.siteName,
  url: siteConfig.url,
  description: t.siteDescription,
  inLanguage: locale,
};
---

<Layout title={`${t.siteName} — ${counts.total}+ ${locale === 'nl' ? 'AI launches in real-time' : 'AI launches in real time'}`}
        description={t.siteDescription}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
  </Fragment>

  <main class="container container-wide">
    <section class="hero">
      <div class="hero__meta">
        <span class="badge badge--primary"><Zap size={11} stroke-width={2} /> {t.hero.live}</span>
        <span>{t.hero.updated} {updated}</span>
      </div>
      <h1 class="hero__title">
        <span class="hero__gradient">{t.hero.titleA}</span>
        <br />{t.hero.titleB}
      </h1>
      <p class="hero__sub">{t.hero.sub(counts.total, counts.trending)}</p>
    </section>

    <LaunchHeatmap items={items} locale={locale} />

    <div class="filter-stack">
    <div class="filter-bar" data-dim="scope">
      <button class="filter-pill is-active" data-filter="all">{t.filters.all} · {counts.total}</button>
      <button class="filter-pill" data-filter="trending">
        <TrendingUp size={11} stroke-width={2} style="vertical-align: -2px; margin-right: 3px;" />
        {t.filters.trending} · {counts.trending}
      </button>
      {Object.entries(counts.bySource).map(([s, n]) => (
        <button class="filter-pill" data-filter={s}>{sourceLabels[s] ?? s} · {n}</button>
      ))}
    </div>

    <div class="cat-bar" data-dim="category" aria-label={t.filters.categoryHeading}>
      <button class="cat-pill is-active" data-cat-filter="all" type="button">
        <Layers size={11} stroke-width={2} />
        {t.filters.categoryAll}
      </button>
      {CATEGORY_ORDER
        .filter((c) => (counts.byCategory?.[c] ?? 0) > 0)
        .map((c) => {
          const Icon = CategoryIcon[c];
          const n = counts.byCategory[c];
          return (
            <button class="cat-pill" data-cat={c} data-cat-filter={c} type="button">
              {Icon && <Icon size={11} stroke-width={1.8} />}
              <span>{categoryLabel(c, locale)}</span>
              <span class="cat-pill__count">{n}</span>
            </button>
          );
        })}
    </div>
    </div>

    <div class="feed-grid" id="feed-grid" data-locale={locale}>
      {items.map((it) => <FeedItemCard item={it} locale={locale} />)}
    </div>

    <div class="load-more" id="load-more-wrap" hidden>
      <button class="load-more__btn" id="load-more" type="button">
        {locale === 'nl' ? 'Meer laden' : 'Load more'}
      </button>
      <p class="load-more__count" id="load-more-count"></p>
    </div>

    <div class="empty-state" id="empty-state" hidden>
      <h3>{t.filters.emptyTitle}</h3>
      <p>{t.filters.emptyBody}</p>
      <button class="clear-btn" id="clear-filters" type="button">{t.filters.clearAll}</button>
    </div>
  </main>
</Layout>

<style>
  /* Render-perf: laat de browser off-screen kaarten overslaan. */
  .feed-grid > .feed-card {
    content-visibility: auto;
    contain-intrinsic-size: auto 220px;
  }

  /* Laad-meer */
  .load-more {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-8) 0 var(--space-4);
  }
  .load-more__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: color-mix(in oklch, var(--primary-bright) 12%, transparent);
    color: var(--primary-bright);
    border: 1px solid var(--border-accent);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-full);
    font-weight: var(--font-semibold);
    font-size: var(--text-sm);
    cursor: pointer;
    transition: background var(--duration-fast), transform var(--duration-fast), box-shadow var(--duration-fast);
  }
  .load-more__btn:hover {
    background: var(--primary-bright);
    color: var(--text-inverse);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }
  .load-more__btn:active { transform: translateY(0); }
  .load-more__count {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-12) var(--space-4);
    color: var(--text-muted);
    border: 1px dashed var(--border-subtle);
    border-radius: var(--radius-lg);
    margin-top: var(--space-4);
  }
  .empty-state h3 {
    color: var(--text-secondary);
    font-size: var(--text-xl);
    margin: 0 0 var(--space-2);
  }
  .empty-state p {
    max-width: 420px;
    margin: 0 auto var(--space-4);
    font-size: var(--text-sm);
  }
  .clear-btn {
    background: var(--primary-bright);
    color: var(--text-inverse);
    border: none;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    font-weight: var(--font-semibold);
    font-size: var(--text-sm);
    cursor: pointer;
    transition: filter var(--duration-fast);
  }
  .clear-btn:hover { filter: brightness(1.15); }
</style>

<script>
  // Two-dimensional filtering: scope (all/trending/source) AND category.
  const grid = document.getElementById('feed-grid');
  const scopePills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
  const catPills = document.querySelectorAll<HTMLButtonElement>('.cat-pill');

  let activeScope = 'all';
  let activeCategory = 'all';
  let activeDate: string | null = null;

  // Laad-meer: filteren bepaalt de match-set, deze limiet bepaalt hoeveel
  // ervan zichtbaar zijn. Reset naar PAGE_SIZE bij elke filterwijziging.
  const PAGE_SIZE = 48;
  let shownCount = PAGE_SIZE;

  const emptyState = document.getElementById('empty-state') as HTMLElement;
  const clearBtn = document.getElementById('clear-filters') as HTMLButtonElement;
  const loadMoreWrap = document.getElementById('load-more-wrap') as HTMLElement;
  const loadMoreBtn = document.getElementById('load-more') as HTMLButtonElement;
  const loadMoreCount = document.getElementById('load-more-count') as HTMLElement;
  const FEED_LOCALE = grid?.dataset.locale === 'en' ? 'en' : 'nl';

  function applyFilters() {
    const cards = grid?.querySelectorAll<HTMLAnchorElement>('.feed-card');
    let matched = 0;
    let visible = 0;
    cards?.forEach((c) => {
      const src = c.dataset.source;
      const trending = c.querySelector('.badge--trending');
      const cats = (c.dataset.cats ?? '').split(' ').filter(Boolean);
      const created = c.dataset.created ?? '';

      let scopeMatch = true;
      if (activeScope === 'trending') scopeMatch = !!trending;
      else if (activeScope !== 'all') scopeMatch = src === activeScope;

      const catMatch = activeCategory === 'all' || cats.includes(activeCategory);
      const dateMatch = !activeDate || created.slice(0, 10) === activeDate;

      if (!(scopeMatch && catMatch && dateMatch)) {
        c.style.display = 'none';
        return;
      }
      matched++;
      // Toon alleen de eerste `shownCount` matches; de rest wacht op "Load more".
      if (matched <= shownCount) { c.style.display = ''; visible++; }
      else c.style.display = 'none';
    });

    // Show empty-state when filters yield 0 cards AND at least one filter is active
    const anyActive = activeScope !== 'all' || activeCategory !== 'all' || activeDate !== null;
    if (matched === 0 && anyActive) {
      emptyState.hidden = false;
      if (grid) grid.style.display = 'none';
      loadMoreWrap.hidden = true;
      return;
    }
    emptyState.hidden = true;
    if (grid) grid.style.display = '';

    // Laad-meer knop + teller
    if (matched > shownCount) {
      loadMoreWrap.hidden = false;
      loadMoreCount.textContent = FEED_LOCALE === 'nl'
        ? `${visible} van ${matched} getoond`
        : `Showing ${visible} of ${matched}`;
    } else {
      loadMoreWrap.hidden = true;
    }
  }

  // Filterwijziging → terug naar de eerste pagina.
  function filterChanged() {
    shownCount = PAGE_SIZE;
    applyFilters();
  }

  loadMoreBtn?.addEventListener('click', () => {
    shownCount += PAGE_SIZE;
    applyFilters();
  });

  function clearAllFilters() {
    activeScope = 'all';
    activeCategory = 'all';
    activeDate = null;
    scopePills.forEach((p) => p.classList.toggle('is-active', p.dataset.filter === 'all'));
    catPills.forEach((p) => p.classList.toggle('is-active', p.dataset.catFilter === 'all'));
    document.querySelectorAll('.heatmap-cell--selected').forEach((x) => x.classList.remove('heatmap-cell--selected'));
    // Clean URL too
    history.replaceState({}, '', location.pathname);
    filterChanged();
  }
  clearBtn?.addEventListener('click', clearAllFilters);

  // Heatmap day → filter feed to that date
  document.addEventListener('heatmap-day-select', (e: Event) => {
    const detail = (e as CustomEvent).detail;
    activeDate = activeDate === detail.date ? null : detail.date;
    // Visual: pulse the active day cell
    document.querySelectorAll('.heatmap-cell--selected').forEach((x) => x.classList.remove('heatmap-cell--selected'));
    if (activeDate) {
      document.querySelector(`.heatmap-cell[data-date="${activeDate}"]`)?.classList.add('heatmap-cell--selected');
    }
    filterChanged();
    // Scroll to grid
    grid?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  scopePills.forEach((p) => {
    p.addEventListener('click', () => {
      scopePills.forEach((x) => x.classList.remove('is-active'));
      p.classList.add('is-active');
      activeScope = p.dataset.filter || 'all';
      filterChanged();
    });
  });

  catPills.forEach((p) => {
    p.addEventListener('click', () => {
      catPills.forEach((x) => x.classList.remove('is-active'));
      p.classList.add('is-active');
      activeCategory = p.dataset.catFilter || 'all';
      filterChanged();
    });
  });

  // URL params: ?source=... or ?filter=trending (scope), ?cat=... (category)
  const params = new URLSearchParams(location.search);
  const scopeParam = params.get('filter') || params.get('source');
  if (scopeParam) {
    const pill = document.querySelector<HTMLButtonElement>(`.filter-pill[data-filter="${scopeParam}"]`);
    pill?.click();
  }
  const catParam = params.get('cat') || params.get('category');
  if (catParam) {
    const pill = document.querySelector<HTMLButtonElement>(`.cat-pill[data-cat-filter="${catParam}"]`);
    pill?.click();
  }

  // Pas de initiële pagina-limiet toe (ook als er geen URL-filter is).
  applyFilters();
</script>
