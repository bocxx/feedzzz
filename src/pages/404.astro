---
/**
 * Custom 404 — Cloudflare Workers Assets serveert dist/404.html voor elke
 * onbekende URL (wrangler.toml: not_found_handling = "404-page"). Relevant
 * omdat item-URL's wekelijks uit de dataset roteren: extern gedeelde links
 * naar verdwenen items landen hier. Eén pagina voor NL + EN (assets kent
 * geen per-locale 404), dus NL-eerst met een korte EN-regel.
 */
import Layout from '../layouts/Layout.astro';
import { ROUNDUPS } from '../lib/roundups';
import { ArrowRight } from '@lucide/astro';
---

<Layout title="404 — niet gevonden · feedzz" description="Pagina niet gevonden." robots="noindex, follow">
  <main class="container notfound">
    <div class="notfound__inner">
      <p class="notfound__code">404</p>
      <h1 class="notfound__title">Deze pagina staat niet (meer) in de feed.</h1>
      <p class="notfound__lede">
        Items roteren wekelijks uit de dataset — een gedeelde link kan dus verlopen zijn.
        Kies hieronder een overzicht, daar staat de actuele versie.
        <span class="notfound__en">This page is gone or never existed — pick a roundup below.</span>
      </p>

      <nav class="notfound__hubs" aria-label="Overzichten">
        {ROUNDUPS.map((r) => (
          <a class="notfound__hub" href={`/${r.slug}/`}>
            <span>{r.nl.title}</span>
            <ArrowRight size={14} stroke-width={1.75} aria-hidden="true" />
          </a>
        ))}
      </nav>

      <p class="notfound__home">
        Of <a href="/">terug naar de feed</a> · <a href="/en/">English feed</a>
      </p>
    </div>
  </main>

  {/* 404-meting: log de niet-gevonden URL + referrer. Vangt kapotte interne
      links en verlopen item-URL's live op (zelfde patroon als HLN). */}
  <script is:inline>
    (function () {
      function fire() {
        if (!(window.umami && window.umami.track)) return false;
        window.umami.track('not-found', { path: location.pathname, ref: document.referrer || '' });
        return true;
      }
      if (fire()) return;
      var n = 0;
      var iv = setInterval(function () { if (fire() || ++n > 100) clearInterval(iv); }, 50);
    })();
  </script>
</Layout>

<style>
  .notfound {
    display: grid;
    place-items: center;
    min-height: 60dvh;
    padding-block: var(--space-12);
  }
  .notfound__inner {
    max-width: 56ch;
    text-align: center;
  }
  .notfound__code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--primary-bright);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    margin: 0 0 var(--space-4);
  }
  .notfound__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.3rem + 2vw, 2.5rem);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-tight);
    line-height: 1.15;
    margin: 0 0 var(--space-4);
  }
  .notfound__lede {
    color: var(--text-secondary);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-8);
  }
  .notfound__en {
    display: block;
    margin-top: var(--space-2);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  .notfound__hubs {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    margin: 0 0 var(--space-8);
    text-align: left;
  }
  @media (min-width: 30em) {
    .notfound__hubs { grid-template-columns: 1fr 1fr; }
  }
  .notfound__hub {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-panel);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color var(--duration-fast), border-color var(--duration-fast), transform var(--duration-fast);
  }
  .notfound__hub:hover {
    color: var(--text-primary);
    border-color: var(--border-accent);
    transform: translateX(2px);
  }
  .notfound__hub svg { color: var(--primary-bright); flex-shrink: 0; }
  .notfound__home {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .notfound__home a { color: var(--primary-bright); text-decoration: none; }
  .notfound__home a:hover { text-decoration: underline; }
</style>
