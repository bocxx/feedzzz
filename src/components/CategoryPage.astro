---
/**
 * CategoryPage — gedeeld template voor de statische categorie-hubs
 * (/categorie/[cat]/ + /en/category/[cat]/). Zelfde opzet als RoundupPage:
 * unieke title/lead per categorie, live aggregaat-cijfers in de intro en
 * CollectionPage/ItemList-JSON-LD.
 */
import Layout from '../layouts/Layout.astro';
import FeedItemCard from './molecules/FeedItemCard.astro';
import { siteConfig } from '../config/site';
import { CATEGORY_ORDER, CATEGORY_PAGES, getCategoryItems, categoryHref, type CategorySlug } from '../lib/categories';
import { getGeneratedAt, categoryLabel } from '../lib/data';
import { useTranslations, localizedHref, getDateLocale, type Locale } from '../i18n/messages';
import {
  Sparkles, Code, Bot, Wrench, GraduationCap, Microscope,
  Briefcase, Palette, BookOpen, Megaphone, ShieldCheck, ArrowLeft, ArrowRight,
} from '@lucide/astro';

interface Props { cat: CategorySlug; locale: Locale; }
const { cat, locale } = Astro.props;

const cfg = CATEGORY_PAGES[cat];
const copy = cfg[locale];
const t = useTranslations(locale);

const ICONS = {
  sparkles: Sparkles, code: Code, bot: Bot, wrench: Wrench,
  graduationcap: GraduationCap, microscope: Microscope, briefcase: Briefcase,
  palette: Palette, bookopen: BookOpen, megaphone: Megaphone, shieldcheck: ShieldCheck,
} as const;
const Icon = ICONS[cfg.icon];

const allInCat = getCategoryItems(cat);
const items = allInCat.slice(0, 100);
const total = allInCat.length;
const trending = allInCat.filter((i) => i.is_trending).length;
const top = allInCat.find((i) => i.is_trending) ?? allInCat[0] ?? null;

const updated = new Date(getGeneratedAt()).toLocaleDateString(getDateLocale(locale), {
  day: 'numeric', month: 'short',
});

// Live, data-gedreven contextzin — maakt elke pagina uniek + actueel.
let context = '';
if (top) {
  context = locale === 'nl'
    ? `We volgen er nu ${total} in deze categorie, waarvan ${trending} trending. Bovenaan staat ${top.title}.`
    : `We're tracking ${total} in this category right now, ${trending} of them trending. At the top: ${top.title}.`;
}

const pageUrl = `${siteConfig.url}${categoryHref(cat, locale)}`;
const otherCats = CATEGORY_ORDER.filter((c) => c !== cat);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: copy.title,
  description: copy.lead,
  url: pageUrl,
  inLanguage: locale,
  isPartOf: { '@type': 'WebSite', name: t.siteName, url: siteConfig.url },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: items.length,
    itemListElement: items.slice(0, 20).map((it, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: it.url,
      name: it.title,
    })),
  },
};
---

<Layout title={`${copy.title} · ${t.siteName}`} description={copy.lead} ogType="website">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main class="container container-wide">
    <a href={localizedHref('/', locale)} class="cathub__back">
      <ArrowLeft size={14} stroke-width={2} /> {locale === 'nl' ? 'Naar de feed' : 'Back to feed'}
    </a>

    <header class="cathub-hero">
      <div class="cathub-hero__icon"><Icon size={26} stroke-width={1.6} /></div>
      <span class="cathub-hero__kicker">{copy.kicker}</span>
      <h1 class="cathub-hero__title">{copy.title}</h1>
      <p class="cathub-hero__lead">{copy.lead}</p>
      {context && <p class="cathub-hero__context">{context}</p>}
      <p class="cathub-hero__meta">
        <strong>{total}</strong> items
        · <strong>{trending}</strong> trending
        · {locale === 'nl' ? 'bijgewerkt' : 'updated'} {updated}
      </p>
    </header>

    <div class="feed-grid">
      {items.map((it) => <FeedItemCard item={it} locale={locale} />)}
    </div>

    <section class="cathub-more">
      <h2>{locale === 'nl' ? 'Meer onderwerpen' : 'More topics'}</h2>
      <div class="cathub-more__links">
        {otherCats.map((c) => (
          <a href={categoryHref(c, locale)} class="cathub-more__link">
            <span>{categoryLabel(c, locale)}</span>
            <ArrowRight size={14} stroke-width={2} />
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  .cathub__back {
    display: inline-flex; align-items: center; gap: var(--space-1);
    color: var(--text-muted); font-size: var(--text-sm);
    text-decoration: none; margin: var(--space-4) 0 var(--space-2);
    transition: color var(--duration-fast);
  }
  .cathub__back:hover { color: var(--primary-bright); }

  .cathub-hero {
    max-width: 760px;
    margin: 0 auto var(--space-8);
    padding-top: var(--space-4);
    text-align: center;
  }
  .cathub-hero__icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 52px; height: 52px; border-radius: var(--radius-lg);
    background: color-mix(in oklch, var(--primary-bright) 12%, transparent);
    color: var(--primary-bright); margin-bottom: var(--space-3);
  }
  .cathub-hero__kicker {
    display: block; text-transform: uppercase; letter-spacing: var(--tracking-wider);
    font-size: var(--text-xs); font-weight: var(--font-semibold);
    color: var(--text-muted); margin-bottom: var(--space-2);
  }
  .cathub-hero__title {
    font-family: var(--font-display); font-size: var(--text-4xl);
    font-weight: var(--font-bold); line-height: 1.1;
    letter-spacing: var(--tracking-tight); margin: 0 0 var(--space-4);
  }
  .cathub-hero__lead {
    color: var(--text-secondary); font-size: var(--text-lg);
    line-height: var(--leading-relaxed); margin: 0 auto var(--space-3); max-width: 680px;
  }
  .cathub-hero__context {
    color: var(--text-secondary); font-size: var(--text-base);
    margin: 0 auto var(--space-4); max-width: 680px;
  }
  .cathub-hero__context strong, .cathub-hero__meta strong { color: var(--text-primary); }
  .cathub-hero__meta {
    font-family: var(--font-mono); font-size: var(--text-sm);
    color: var(--text-muted); margin: 0;
  }

  .cathub-more {
    margin-top: var(--space-16); padding-top: var(--space-8);
    border-top: 1px solid var(--border-subtle);
  }
  .cathub-more h2 {
    font-size: var(--text-xl); font-weight: var(--font-bold);
    margin: 0 0 var(--space-4);
  }
  .cathub-more__links {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: var(--space-3);
  }
  .cathub-more__link {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-3);
    padding: var(--space-3) var(--space-4); border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg); background: var(--bg-panel);
    color: var(--text-primary); text-decoration: none;
    font-weight: var(--font-medium); font-size: var(--text-sm);
    transition: border-color var(--duration-fast), transform var(--duration-fast);
  }
  .cathub-more__link:hover {
    border-color: var(--border-accent); transform: translateY(-2px);
  }
  .cathub-more__link svg { color: var(--primary-bright); flex-shrink: 0; }
</style>
