---
import { Zap, Languages } from '@lucide/astro';
import { useTranslations, localizedHref, getAlternateUrl, type Locale } from '../i18n/messages';
import ThemeToggle from './ThemeToggle.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
const otherLocale: Locale = locale === 'nl' ? 'en' : 'nl';
const otherHref = getAlternateUrl(Astro.url.pathname, locale);

const nav = [
  { label: t.nav.feed, href: localizedHref('/', locale) },
  { label: t.nav.trending, href: localizedHref('/trending', locale) },
  { label: t.nav.models, href: localizedHref('/ai-modellen', locale) },
  { label: t.nav.launches, href: localizedHref('/ai-launches', locale) },
  { label: t.nav.repos, href: localizedHref('/ai-repos', locale) },
  { label: t.nav.trends, href: localizedHref('/trends', locale) },
  { label: t.nav.about, href: t.aboutPath },
];
---

<header class="site-header">
  <div class="container container-wide site-header__inner">
    <a href={localizedHref('/', locale)} class="site-logo" aria-label="feedzz home">
      <Zap size={18} stroke-width={2.4} style="color: var(--primary-bright); vertical-align: -3px;" />
      feed<span class="accent">zz</span>
    </a>
    <nav class="site-nav" aria-label={locale === 'nl' ? 'Hoofdnavigatie' : 'Primary'}>
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href={otherHref} class="lang-toggle" aria-label={locale === 'nl' ? 'Switch to English' : 'Schakel naar Nederlands'}>
        <Languages size={14} stroke-width={2} style="vertical-align: -2px; margin-right: 4px;" />
        {otherLocale.toUpperCase()}
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>

<script>
  // Scroll-affordance: fade aan de rechterrand van de nav zolang er buiten
  // beeld nog items staan (mobiel: 7 nav-items + taal + thema in één balk).
  const nav = document.querySelector<HTMLElement>('.site-nav');
  if (nav) {
    const update = () => {
      const more = nav.scrollWidth - nav.clientWidth - nav.scrollLeft > 4;
      nav.classList.toggle('has-overflow', more);
    };
    nav.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  }
</script>

<style>
  .lang-toggle {
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary) !important;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
  }
  .lang-toggle:hover {
    color: var(--primary-bright) !important;
    border-color: var(--border-accent);
  }
</style>
